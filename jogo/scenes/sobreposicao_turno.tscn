layout_mode = 2
mouse_default_cursor_shape = 2
text = "Fechar (Esc)"

[node name="Manual" type="ScrollContainer" parent="Painel/Conteudo"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Regras" type="Label" parent="Painel/Conteudo/Manual"]
layout_mode = 2
size_flags_horizontal = 3
text = "Arraste os documentos da bandeja para a mesa. Use dois cliques para ampliar um documento e pressione Esc para voltar à mesa.

Identidade
Compare a foto com a pessoa no guichê e o nome com a ficha. Confira a validade para o ano letivo de 2026 e procure rasuras.

Convocação do vestibular
Confira se o curso e o turno da convocação coincidem com a ficha e se a nota atinge o corte mostrado no documento.

Histórico escolar
Confira a conclusão do ensino médio, as notas e o carimbo oficial. Atenção a datas futuras e alterações à mão.

Parecer de matrícula
Abra a gaveta pela seta à direita. Clique no carimbo escolhido e depois na área destacada da ficha. Aprove documentos regulares e reprove se houver alguma irregularidade."
autowrap_mode = 3

[node name="Proporcao" type="AspectRatioContainer" parent="Painel/Conteudo"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3

[node name="CopiaDocumento" parent="Painel/Conteudo/Proporcao" instance=ExtResource("3_documento")]
